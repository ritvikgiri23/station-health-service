# Station Health Service configuration.
# Copy to `.env` to override the defaults. docker-compose reads it automatically.
# Every setting the service reads is listed here.

# --- Service ---------------------------------------------------------------

# SQLAlchemy URL of the MySQL 8 database. Required.
# Inside docker-compose the host is `mysql`; from your machine it is 127.0.0.1:$MYSQL_PORT.
DATABASE_URL=mysql+pymysql://station_health:station_health@mysql:3306/station_health

# Minimum log level for the app and gunicorn: DEBUG, INFO, WARNING, ERROR or CRITICAL.
# Default: INFO.
LOG_LEVEL=INFO

# Number of gunicorn worker processes. Default: 2.
WEB_CONCURRENCY=2

# --- API keys ----------------------------------------------------------------
# Comma-separated keys for each role, sent in the X-API-Key header. A key listed
# under several roles holds all of them. No keys configured means every protected
# endpoint answers 401. These are local demo values; never reuse them anywhere real.

# The Collector: submit Health Reports only.
API_KEYS_INGEST=dev-ingest-key
# Operators and the dashboard: read Station health, the Poor Hygiene list and metrics.
API_KEYS_READ=dev-read-key
# Station Registry management.
API_KEYS_ADMIN=dev-admin-key

# --- Dashboard ---------------------------------------------------------------

# A key the dashboard page at /dashboard carries, so it loads without typing a key in.
# Anyone who can open the page can read it, so it must be a key with only the `read`
# role (the service refuses to start otherwise). For local use only: unset, the page
# asks for a read key instead. The service's default is unset; this local demo value
# (also docker-compose's default) turns it on. Remove it anywhere real.
DASHBOARD_DEMO_KEY=dev-read-key

# --- Ingest ------------------------------------------------------------------

# Health Reports timestamped further than this into the future are rejected (422).
# Default: 300.
INGEST_FUTURE_TOLERANCE_SECONDS=300

# How long raw Health Reports are kept. Older Health Reports are rejected at ingest
# (422). Default: 48.
RAW_RETENTION_HOURS=48

# --- Retention -----------------------------------------------------------------
# Each worker cycle deletes raw Health Reports older than RAW_RETENTION_HOURS and hourly
# summaries older than this many days. Default: 30.
SUMMARY_RETENTION_DAYS=30

# Rows deleted per statement by retention clean-up, so no delete holds locks for long.
# Default: 10000.
RETENTION_BATCH_SIZE=10000

# --- Scoring ------------------------------------------------------------------
# Hygiene Score = Availability x (LATENCY_WEIGHT x latency score + ERROR_WEIGHT x error score)
# x 100, rounded half up. See "Scoring formula" in docs/station-health-service/spec.md.

# Length of the Scoring Window: each Station is scored from its Health Reports with a
# timestamp in (now - window, now]. Default: 15.
SCORING_WINDOW_MINUTES=15

# How often the worker starts a scoring run. Default: 60.
WORKER_INTERVAL_SECONDS=60

# /readyz reports `degraded` (still 200) when the last scoring run is older than this,
# so a stuck or dead worker is visible. Default: 180.
SCORING_STALE_AFTER_SECONDS=180

# The latency score is 1.0 when the p95 latency of online Health Reports is at or below
# LATENCY_GOOD_MS, 0.0 at or above LATENCY_BAD_MS, and linear in between.
# Defaults: 150 and 1000.
LATENCY_GOOD_MS=150
LATENCY_BAD_MS=1000

# The error score is 1.0 at 0 errors per online Health Report, 0.0 at this many or more,
# and linear in between. Default: 3.
ERROR_LIMIT_PER_REPORT=3

# Weights of the latency and error scores. They must add up to 1. Defaults: 0.4 and 0.6.
LATENCY_WEIGHT=0.4
ERROR_WEIGHT=0.6

# --- Flagging -------------------------------------------------------------------
# A Station enters Poor Hygiene when it is Silent (no Health Reports in its Scoring Window)
# or its Hygiene Score is below FLAG_THRESHOLD. It leaves only when it is not Silent, its
# score is at least CLEAR_THRESHOLD, and its window holds at least MIN_REPORTS_TO_CLEAR
# Health Reports. Thresholds are integers from 0 to 100, and CLEAR_THRESHOLD must be at
# least FLAG_THRESHOLD. Defaults: 60, 70 and 5.
FLAG_THRESHOLD=60
CLEAR_THRESHOLD=70
MIN_REPORTS_TO_CLEAR=5

# --- docker-compose only ---------------------------------------------------

# Credentials for the MySQL container. Keep them in step with DATABASE_URL.
MYSQL_DATABASE=station_health
MYSQL_USER=station_health
MYSQL_PASSWORD=station_health
MYSQL_ROOT_PASSWORD=root

# The optional simulator (`make simulate`). See "Simulator" in the README.
# Keys it uses to register its Stations (admin) and send Health Reports (ingest).
SIM_INGEST_KEY=dev-ingest-key
SIM_ADMIN_KEY=dev-admin-key
# Stations to simulate; profiles are assigned in turn. Default: 50.
SIM_STATIONS=50
# Simulated minutes per real minute while replaying the backlog. Must be above 1.
# Default: 60.
SIM_SPEED=60
# How far in the past simulated time starts. Default: 30.
SIM_BACKLOG_MINUTES=30

# Host ports published by docker-compose.
API_PORT=8000
MYSQL_PORT=3306
